    <worksheet name='Vacant Properties Sold'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontcolor='#898989' fontname='Segoe UI'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='saleinfo (NashvilleHousingData)' name='federated.1jl4vum0vxq9831exgl4y18tdunt' />
          </datasources>
          <datasource-dependencies datasource='federated.1jl4vum0vxq9831exgl4y18tdunt'>
            <column caption='Land Use' datatype='string' name='[LandUse]' role='dimension' type='nominal' />
            <column caption='G-Land Use' datatype='string' name='[Low-Density Residential]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[LandUse]' new-bin='true'>
                <bin default-name='false' value='&quot;Low-Density Residential&quot;'>
                  <value>&quot;DUPLEX&quot;</value>
                  <value>&quot;MOBILE HOME&quot;</value>
                  <value>&quot;QUADPLEX&quot;</value>
                  <value>&quot;TRIPLEX&quot;</value>
                  <value>&quot;ZERO LOT LINE&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Multi-Family Residential&quot;'>
                  <value>&quot;CONDO&quot;</value>
                  <value>&quot;DORMITORY/BOARDING HOUSE&quot;</value>
                  <value>&quot;RESIDENTIAL COMBO/MISC&quot;</value>
                  <value>&quot;SPLIT CLASS&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Special Use&quot;'>
                  <value>&quot;APARTMENT: LOW RISE (BUILT SINCE 1960)&quot;</value>
                  <value>&quot;CLUB/UNION HALL/LODGE&quot;</value>
                  <value>&quot;CONDOMINIUM OFC  OR OTHER COM CONDO&quot;</value>
                  <value>&quot;CONVENIENCE MARKET WITHOUT GAS&quot;</value>
                  <value>&quot;DAY CARE CENTER&quot;</value>
                  <value>&quot;FOREST&quot;</value>
                  <value>&quot;GREENBELT&quot;</value>
                  <value>&quot;GREENBELT/RES&#13;&#10;GRRENBELT/RES&quot;</value>
                  <value>&quot;LIGHT MANUFACTURING&quot;</value>
                  <value>&quot;METRO OTHER THAN OFC, SCHOOL,HOSP, OR PARK&quot;</value>
                  <value>&quot;MORTUARY/CEMETERY&quot;</value>
                  <value>&quot;NIGHTCLUB/LOUNGE&quot;</value>
                  <value>&quot;NON-PROFIT CHARITABLE SERVICE&quot;</value>
                  <value>&quot;OFFICE BLDG (ONE OR TWO STORIES)&quot;</value>
                  <value>&quot;ONE STORY GENERAL RETAIL STORE&quot;</value>
                  <value>&quot;PARKING LOT&quot;</value>
                  <value>&quot;PARSONAGE&quot;</value>
                  <value>&quot;RESTURANT/CAFETERIA&quot;</value>
                  <value>&quot;SMALL SERVICE SHOP&quot;</value>
                  <value>&quot;STRIP SHOPPING CENTER&quot;</value>
                  <value>&quot;TERMINAL/DISTRIBUTION WAREHOUSE&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Vacant Land&quot;'>
                  <value>&quot;VACANT COMMERCIAL LAND&quot;</value>
                  <value>&quot;VACANT RES LAND&quot;</value>
                  <value>&quot;VACANT RESIENTIAL LAND&quot;</value>
                  <value>&quot;VACANT RURAL LAND&quot;</value>
                  <value>&quot;VACANT ZONED MULTI FAMILY&quot;</value>
                </bin>
              </calculation>
            </column>
            <column caption='Sale Date' datatype='date' name='[SaleDate]' role='dimension' type='ordinal' />
            <column caption='Sold As Vacant' datatype='string' name='[SoldAsVacant]' role='dimension' type='nominal' />
            <column caption='Tax District' datatype='string' name='[TaxDistrict]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;CITY OF BELLE MEADE&quot;' value='BELLE MEADE' />
                <alias key='&quot;CITY OF BERRY HILL&quot;' value='BERRY HILL' />
                <alias key='&quot;CITY OF FOREST HILLS&quot;' value='FOREST HILLS' />
                <alias key='&quot;CITY OF GOODLETTSVILLE&quot;' value='GOODLETTSVILLE' />
                <alias key='&quot;CITY OF OAK HILL&quot;' value='OAK HILL' />
                <alias key='&quot;GENERAL SERVICES DISTRICT&quot;' value='GENERAL SERVICES' />
                <alias key='&quot;URBAN SERVICES DISTRICT&quot;' value='URBAN SERVICES' />
              </aliases>
            </column>
            <column-instance column='[SoldAsVacant]' derivation='Count' name='[cnt:SoldAsVacant:qk]' pivot='key' type='quantitative' />
            <column-instance column='[SoldAsVacant]' derivation='None' name='[none:SoldAsVacant:nk]' pivot='key' type='nominal' />
            <column-instance column='[SoldAsVacant]' derivation='Count' name='[pcto:cnt:SoldAsVacant:qk]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Rows' type='PctTotal' />
            </column-instance>
            <column caption='Propertyage' datatype='string' name='[propertyage]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;09- Modern&quot;' value='Modern' />
                <alias key='&quot;49- Old&quot;' value='Old' />
                <alias key='&quot;69- Mid-Century&quot;' value='Mid-Century' />
                <alias key='&quot;90- Very Old&quot;' value='Very Old' />
                <alias key='&quot;99- Relatively Modern&quot;' value='Relatively Modern' />
                <alias key='&quot;Cur- Very Modern&quot;' value='Very Modern' />
              </aliases>
            </column>
            <column caption='Saleprice Value' datatype='string' name='[saleprice_value]' role='dimension' type='nominal' />
            <column caption='Status' datatype='string' name='[status]' role='dimension' type='nominal' />
            <column-instance column='[SaleDate]' derivation='Month-Trunc' name='[tmn:SaleDate:ok]' pivot='key' type='ordinal' />
            <column-instance column='[SaleDate]' derivation='Month-Trunc' name='[tmn:SaleDate:qk]' pivot='key' type='quantitative' />
            <column-instance column='[SaleDate]' derivation='Quarter-Trunc' name='[tqr:SaleDate:ok]' pivot='key' type='ordinal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1jl4vum0vxq9831exgl4y18tdunt].[Action (G-Land Use,MONTH(Sale Date))]'>
            <groupfilter function='crossjoin' user:ui-action-filter='[Action11_4BB52F768DB04AD2ACE6F6D394E5C8DC]' user:ui-enumeration='all' user:ui-marker='enumerate'>
              <groupfilter function='level-members' level='[Low-Density Residential]' />
              <groupfilter function='level-members' level='[tmn:SaleDate:ok]' />
            </groupfilter>
          </filter>
          <filter class='categorical' column='[federated.1jl4vum0vxq9831exgl4y18tdunt].[Action (QUARTER(Sale Date),Propertyage)]'>
            <groupfilter function='crossjoin' user:ui-action-filter='[Action8_415240F2CC484867B9D4A89F39503685]' user:ui-enumeration='all' user:ui-marker='enumerate'>
              <groupfilter function='level-members' level='[tqr:SaleDate:ok]' />
              <groupfilter function='level-members' level='[propertyage]' />
            </groupfilter>
          </filter>
          <filter class='categorical' column='[federated.1jl4vum0vxq9831exgl4y18tdunt].[Action (QUARTER(Sale Date),Tax District)]'>
            <groupfilter function='crossjoin' user:ui-action-filter='[Action9_907CCF01D91A44E587D46B7E57377CC0]' user:ui-enumeration='all' user:ui-marker='enumerate'>
              <groupfilter function='level-members' level='[tqr:SaleDate:ok]' />
              <groupfilter function='level-members' level='[TaxDistrict]' />
            </groupfilter>
          </filter>
          <filter class='categorical' column='[federated.1jl4vum0vxq9831exgl4y18tdunt].[Action (Saleprice Value)]'>
            <groupfilter function='level-members' level='[saleprice_value]' user:ui-action-filter='[Action3_40377A5475B94736836217E1872DFE65]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.1jl4vum0vxq9831exgl4y18tdunt].[Action (Status)]'>
            <groupfilter function='level-members' level='[status]' user:ui-action-filter='[Action4_4AE35EB9BA9F4049824B495BFB88F1C2]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <slices>
            <column>[federated.1jl4vum0vxq9831exgl4y18tdunt].[tmn:SaleDate:qk]</column>
